# Blender: el .blend se regenera con generar_sala_domo.py; el .blend1 es autosave
01_Blender/*.blend1

# Export: los FBX sí van (~1 MB cada uno: sala_domo.fbx, sala_domo_90.fbx, sala_domo_45.fbx);
# los GLB (3 a 14 MB) y las texturas duplicadas de los .fbm no
02_Export/*.glb
02_Export/*.fbm/

# respaldos de scripts y basura
*.bak_*
*.pyc
__pycache__/
Thumbs.db
.DS_Store

# TouchDesigner
*.toe.orig
*.dir/
Backup*/
*.tmp

# Unreal escribe este perfil de vista previa solo; no es configuracion del proyecto
03_Unreal/DomoVR/Config/DefaultEditor.ini

# Version standalone: los videos no van al repo (derechos y peso); la playlist
# de trabajo tampoco (la de ejemplo vive en 03_Unreal/Movies_ejemplo/).
03_Unreal/DomoVR/Content/Movies/
Movies/*.mp4
Movies/*.mov
# Builds empaquetados (empaquetar.ps1)
03_Unreal/Build/
03_Unreal/DomoVR/Saved/StagedBuilds/
03_Unreal/DomoVR/Build/
